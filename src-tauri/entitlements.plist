<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow outbound network connections (required for DB connections) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Allow spawning subprocesses (required for SSH tunnel via system ssh binary) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <false/>

  <!-- Read/write files the user selects (required for DuckDB file import) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Read access to Downloads/Documents for DuckDB file paths typed by user -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
</dict>
</plist>
